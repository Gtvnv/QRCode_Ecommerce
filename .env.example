# Configuração do gerador de senhas
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Conjuntos de caracteres habilitados (true/false)
UPPERCASE_LETTERS=true
LOWERCASE_LETTERS=true
NUMBERS=true
SPECIAL_CHARACTERS=true

# Tamanho da senha gerada (inteiro >= 1)
PASSWORD_LENGTH=12
